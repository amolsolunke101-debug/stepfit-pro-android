rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Suspended accounts cannot use cloud/community features.
    function activeUser() {
      return signedIn() && (
        admin()
        || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true
      );
    }

    match /users/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || admin());
      allow create: if activeUser() && request.auth.uid == uid
        && !('blocked' in request.resource.data);
      allow update: if activeUser() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasNone(['blocked']);
      allow update, delete: if admin();

      match /dailyStats/{day} {
        allow read, write: if activeUser() && request.auth.uid == uid;
      }
    }

    match /friendRequests/{requestId} {
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.blocked != true;
      allow read: if activeUser() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
        || admin()
      );
      allow update: if activeUser()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if admin()
        || (activeUser() && resource.data.fromUid == request.auth.uid);
    }

    match /clubs/{clubId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids.hasAny([request.auth.uid]);
      // Club owners may edit only the club name; membership is changed separately.
      allow update: if admin()
        || (activeUser() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        || (activeUser() && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAny([request.auth.uid]));
      allow delete: if admin() || (activeUser() && resource.data.ownerUid == request.auth.uid);
    }

    match /challenges/{challengeId} {
      allow read: if activeUser();
      allow create, delete: if admin();
      allow update: if admin() || (activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids'])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.hasAll(resource.data.participantUids)
        && request.resource.data.participantUids.size() == resource.data.participantUids.size() + 1
        && request.resource.data.participantUids.hasAny([request.auth.uid]));
    }

    match /leaderboards/{boardId} {
      allow read: if activeUser();
      allow write: if admin();
    }
  }
}