rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true
        || !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('blocked', false) != true
      );
    }

    match /profilePhotos/{uid}/{fileName} {
      // Profile photos are private to their owner and authorized admins.
      allow read: if activeUser()
        && (request.auth.uid == uid || request.auth.token.get('admin', false) == true);
      allow write: if activeUser()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}